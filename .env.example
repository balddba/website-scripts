# Copy to .env (gitignored) before running Oracle integration tests.
# uv run pytest tests/oracle

ORACLE_TEST_USER=username
ORACLE_TEST_PASSWORD=password
ORACLE_TEST_CONNECT=host:1521/service
ORACLE_TEST_SCHEMA=test_schema

# Set to 1 only against a disposable PDB. Enables instance-wide DDL
# (block change tracking ENABLE, grant sync/copy, XPLAN package create).
ORACLE_TEST_ALLOW_INSTANCE_DDL=0
